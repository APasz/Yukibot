BOT_PROFILE = yuki
# Required.
# Profiles:
# - yuki: full Discord bot + authority
# - erin: lighter game relay/control bot
# - portal: standalone web portal only; no BOT_TOKEN required
NODE_NAME =
# Required for authenticated Node API deployments. Generate a dedicated random value;
# it must not match DATA_AUTHORITY_TOKEN.
NODE_API_TOKEN_SECRET =
# Maximum bytes accepted for an individual Node API upload (default: 1073741824).
NODE_API_UPLOAD_MAX_BYTES =
NODE_API_BIND_HOST =
NODE_API_PORT =
NODE_API_PUBLIC_BASE_URL =
# Public address users type into their browser or game client.
# - Use a bare host like wakusei.apasz.com, or a full URL like https://wakusei.apasz.com
# - Public URLs should use https outside INDEV; plain http is only for local development
# - Do not include /uploads or any other path
PUBLIC_BASE_URL =
MOD_WEB_PUBLIC_BASE_URL =
MOD_WEB_BIND_HOST =
MOD_WEB_PORT =
MOD_WEB_DISCORD_CLIENT_ID =
MOD_WEB_DISCORD_CLIENT_SECRET =
# Optional override. Defaults to {MOD_WEB_PUBLIC_BASE_URL}/auth/discord/callback.
MOD_WEB_AUTH_REDIRECT_URL =
# Portal session and pending OAuth persistence. Defaults to .cache/mod_web_sessions.
MOD_WEB_SESSION_CACHE_DIR =
# Optional deployed Git commit shown on the login page.
MOD_WEB_BUILD_SHA =

# Authority client base.
# - Full URL preferred when you know the scheme, for example: https://wakusei.apasz.com
# - Bare hosts inherit the scheme from PUBLIC_BASE_URL when that is explicitly set.
# - Otherwise bare hosts default to https.
# - In remote mode, if this is blank, an explicit PUBLIC_BASE_URL is used instead.
# - For BOT_PROFILE=portal, point this at Yuki rather than the portal host.
DATA_AUTHORITY_HOST =
DATA_AUTHORITY_TOKEN =
DATA_AUTHORITY_TIMEOUT_SECONDS =
DATA_AUTHORITY_CACHE_DIR =
# Public authority port override. Usually leave blank unless the public port differs from the URL.
DATA_AUTHORITY_PORT =
# Local bind override for Yuki's authority server. Useful behind nginx/reverse proxies.
DATA_AUTHORITY_BIND_HOST =
DATA_AUTHORITY_BIND_PORT =
DISCORD_GUILD = 
VOICE_CHANNEL = 
TTS_CHANNEL = 
# Optional multi-server voice routing. When set, this overrides VOICE_CHANNEL/TTS_CHANNEL.
# Example:
# VOICE_TARGETS = {"":{"voice_channel":"","tts_channel":""}}
VOICE_TARGETS = 
TTS_ENGINE = auto
TTS_VOICE = en-us
TTS_VARIANT = 
TTS_PIPER_MODEL = 
TTS_PIPER_CONFIG = 
TTS_PIPER_DATA_DIR = 
INDEV = 
BYPASS_WEB_AUTH =
STARTED_CHANNEL = 

DIR_APP = 
DIR_TMP = 
DIR_OPT = 

# Optional explicit launcher tokens for `uv run python dev_cluster.py`.
# - Yuki falls back to BOT_TOKEN when YUKI_BOT_TOKEN is unset.
# - Erin requires ERIN_BOT_TOKEN.
YUKI_BOT_TOKEN =
ERIN_BOT_TOKEN =
BOT_TOKEN = 
EXG_TOKEN = 
MODRINTH_API_KEY = 
CURSEFORGE_API_KEY = 
NEXUSMODS_API_KEY = 
MODIO_API_KEY = 
MODIO_USER_ID = 
STEAM_WEB_API_KEY = 

APP_COMM_PASS = 

# This file must be named ".env"
