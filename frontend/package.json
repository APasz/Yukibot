{
  "name": "yukibot-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "format": "prettier --write .",
    "api:generate": "../.venv/bin/python ../tools/export_network_api.py && openapi-typescript src/generated/openapi.json -o src/generated/api.d.ts",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "build": "pnpm api:generate && pnpm check && vite build"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "openapi-fetch": "^0.15.0",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.0.0",
    "jsdom": "^31.0.1",
    "openapi-typescript": "^7.0.0",
    "prettier": "^3.6.0",
    "prettier-plugin-svelte": "^3.4.0",
    "svelte-check": "^4.3.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
