{
  "$defs": {
    "DelayedProbe": {
      "additionalProperties": false,
      "properties": {
        "target_id": {
          "$ref": "#/$defs/NetworkNodeId"
        },
        "offset_ms": {
          "maximum": 1805000,
          "minimum": 0,
          "title": "Offset Ms",
          "type": "integer"
        },
        "hidden": {
          "title": "Hidden",
          "type": "boolean"
        },
        "browser_delay_ms": {
          "maximum": 86400000,
          "minimum": 0,
          "title": "Browser Delay Ms",
          "type": "integer"
        },
        "status": {
          "const": "browser_delayed",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "target_id",
        "offset_ms",
        "hidden",
        "browser_delay_ms",
        "status"
      ],
      "title": "DelayedProbe",
      "type": "object"
    },
    "FailedProbe": {
      "additionalProperties": false,
      "properties": {
        "target_id": {
          "$ref": "#/$defs/NetworkNodeId"
        },
        "offset_ms": {
          "maximum": 1805000,
          "minimum": 0,
          "title": "Offset Ms",
          "type": "integer"
        },
        "hidden": {
          "title": "Hidden",
          "type": "boolean"
        },
        "browser_delay_ms": {
          "maximum": 86400000,
          "minimum": 0,
          "title": "Browser Delay Ms",
          "type": "integer"
        },
        "status": {
          "enum": [
            "timeout",
            "network_error",
            "http_error"
          ],
          "title": "Status",
          "type": "string"
        },
        "http_status": {
          "anyOf": [
            {
              "maximum": 599,
              "minimum": 100,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Http Status"
        }
      },
      "required": [
        "target_id",
        "offset_ms",
        "hidden",
        "browser_delay_ms",
        "status"
      ],
      "title": "FailedProbe",
      "type": "object"
    },
    "NetworkAppContext": {
      "additionalProperties": false,
      "properties": {
        "app": {
          "$ref": "#/$defs/NetworkMonitoredApp"
        },
        "process": {
          "$ref": "#/$defs/NodeAppProcessSummary"
        },
        "player_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Player Count"
        },
        "player_capacity": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Player Capacity"
        }
      },
      "required": [
        "app",
        "process"
      ],
      "title": "NetworkAppContext",
      "type": "object"
    },
    "NetworkAppName": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "NetworkBandwidthPhase": {
      "additionalProperties": false,
      "properties": {
        "phase": {
          "$ref": "#/$defs/NetworkBandwidthPhaseName"
        },
        "offset_ms": {
          "maximum": 1800000,
          "minimum": 0,
          "title": "Offset Ms",
          "type": "integer"
        },
        "end_ms": {
          "maximum": 1800000,
          "minimum": 0,
          "title": "End Ms",
          "type": "integer"
        },
        "transferred_bytes": {
          "maximum": 1073741824,
          "minimum": 0,
          "title": "Transferred Bytes",
          "type": "integer"
        },
        "ended_by": {
          "enum": [
            "duration",
            "byte_limit",
            "cancelled",
            "error"
          ],
          "title": "Ended By",
          "type": "string"
        }
      },
      "required": [
        "phase",
        "offset_ms",
        "end_ms",
        "transferred_bytes",
        "ended_by"
      ],
      "title": "NetworkBandwidthPhase",
      "type": "object"
    },
    "NetworkBandwidthPhaseName": {
      "enum": [
        "idle",
        "download",
        "upload"
      ],
      "type": "string"
    },
    "NetworkBandwidthTest": {
      "additionalProperties": false,
      "properties": {
        "target": {
          "$ref": "#/$defs/NetworkTarget"
        },
        "max_bytes_per_direction": {
          "default": 33554432,
          "exclusiveMinimum": 0,
          "maximum": 1073741824,
          "title": "Max Bytes Per Direction",
          "type": "integer"
        },
        "transfer_duration_ms": {
          "default": 5000,
          "exclusiveMinimum": 0,
          "maximum": 20000,
          "title": "Transfer Duration Ms",
          "type": "integer"
        },
        "started_at_ms": {
          "minimum": 0,
          "title": "Started At Ms",
          "type": "integer"
        },
        "duration_ms": {
          "maximum": 1800000,
          "minimum": 0,
          "title": "Duration Ms",
          "type": "integer"
        },
        "probes": {
          "items": {
            "$ref": "#/$defs/NetworkProbe"
          },
          "maxItems": 100,
          "title": "Probes",
          "type": "array"
        },
        "phases": {
          "items": {
            "$ref": "#/$defs/NetworkBandwidthPhase"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Phases",
          "type": "array"
        },
        "state": {
          "enum": [
            "completed",
            "cancelled",
            "failed"
          ],
          "title": "State",
          "type": "string"
        },
        "error": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        }
      },
      "required": [
        "target",
        "started_at_ms",
        "duration_ms",
        "probes",
        "phases",
        "state"
      ],
      "title": "NetworkBandwidthTest",
      "type": "object"
    },
    "NetworkContext": {
      "additionalProperties": false,
      "properties": {
        "observed_at_ms": {
          "minimum": 0,
          "title": "Observed At Ms",
          "type": "integer"
        },
        "nodes": {
          "items": {
            "$ref": "#/$defs/NetworkNodeContext"
          },
          "maxItems": 16,
          "title": "Nodes",
          "type": "array"
        },
        "app": {
          "anyOf": [
            {
              "$ref": "#/$defs/NetworkAppContext"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "observed_at_ms",
        "nodes"
      ],
      "title": "NetworkContext",
      "type": "object"
    },
    "NetworkMarker": {
      "additionalProperties": false,
      "properties": {
        "offset_ms": {
          "maximum": 1800000,
          "minimum": 0,
          "title": "Offset Ms",
          "type": "integer"
        },
        "label": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "offset_ms",
        "label"
      ],
      "title": "NetworkMarker",
      "type": "object"
    },
    "NetworkMonitoredApp": {
      "additionalProperties": false,
      "properties": {
        "target_id": {
          "$ref": "#/$defs/NetworkNodeId"
        },
        "node_label": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Node Label",
          "type": "string"
        },
        "app_name": {
          "$ref": "#/$defs/NetworkAppName"
        },
        "label": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "target_id",
        "node_label",
        "app_name",
        "label"
      ],
      "title": "NetworkMonitoredApp",
      "type": "object"
    },
    "NetworkNodeContext": {
      "additionalProperties": false,
      "properties": {
        "target_id": {
          "$ref": "#/$defs/NetworkNodeId"
        },
        "availability": {
          "enum": [
            "online",
            "connecting",
            "offline"
          ],
          "title": "Availability",
          "type": "string"
        },
        "captured_at_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Captured At Ms"
        },
        "cpu_percent": {
          "anyOf": [
            {
              "$ref": "#/$defs/Percent"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "cpu_per_core_percent": {
          "items": {
            "$ref": "#/$defs/Percent"
          },
          "maxItems": 4096,
          "title": "Cpu Per Core Percent",
          "type": "array"
        },
        "ram_percent": {
          "anyOf": [
            {
              "$ref": "#/$defs/Percent"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "portal_latency_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Portal Latency Ms"
        },
        "portal_probe_captured_at_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Portal Probe Captured At Ms"
        }
      },
      "required": [
        "target_id",
        "availability"
      ],
      "title": "NetworkNodeContext",
      "type": "object"
    },
    "NetworkNodeId": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "NetworkProbe": {
      "discriminator": {
        "mapping": {
          "browser_delayed": "#/$defs/DelayedProbe",
          "http_error": "#/$defs/FailedProbe",
          "network_error": "#/$defs/FailedProbe",
          "ok": "#/$defs/SuccessfulProbe",
          "timeout": "#/$defs/FailedProbe"
        },
        "propertyName": "status"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/SuccessfulProbe"
        },
        {
          "$ref": "#/$defs/FailedProbe"
        },
        {
          "$ref": "#/$defs/DelayedProbe"
        }
      ]
    },
    "NetworkRecordedBandwidthTest": {
      "additionalProperties": false,
      "properties": {
        "offset_ms": {
          "maximum": 1800000,
          "minimum": 0,
          "title": "Offset Ms",
          "type": "integer"
        },
        "test": {
          "$ref": "#/$defs/NetworkBandwidthTest"
        }
      },
      "required": [
        "offset_ms",
        "test"
      ],
      "title": "NetworkRecordedBandwidthTest",
      "type": "object"
    },
    "NetworkTarget": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/NetworkNodeId"
        },
        "label": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "url": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Url",
          "type": "string"
        },
        "kind": {
          "enum": [
            "portal",
            "node"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label",
        "url",
        "kind"
      ],
      "title": "NetworkTarget",
      "type": "object"
    },
    "NodeAppProcessSummary": {
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "running",
            "stopped",
            "unavailable"
          ],
          "title": "State",
          "type": "string"
        },
        "captured_at_ms": {
          "minimum": 0,
          "title": "Captured At Ms",
          "type": "integer"
        },
        "pid": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pid"
        },
        "started_at_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Started At Ms"
        },
        "process_count": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Process Count"
        },
        "cpu_percent": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cpu Percent"
        },
        "memory_rss_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Memory Rss Bytes"
        },
        "thread_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Thread Count"
        },
        "read_bytes_per_second": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Read Bytes Per Second"
        },
        "write_bytes_per_second": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Write Bytes Per Second"
        }
      },
      "required": [
        "state",
        "captured_at_ms"
      ],
      "title": "NodeAppProcessSummary",
      "type": "object"
    },
    "Percent": {
      "maximum": 100,
      "minimum": 0,
      "type": "integer"
    },
    "RecordedContext": {
      "additionalProperties": false,
      "properties": {
        "offset_ms": {
          "maximum": 1805000,
          "minimum": 0,
          "title": "Offset Ms",
          "type": "integer"
        },
        "snapshot": {
          "anyOf": [
            {
              "$ref": "#/$defs/NetworkContext"
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "anyOf": [
            {
              "const": "unavailable",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        }
      },
      "required": [
        "offset_ms",
        "snapshot"
      ],
      "title": "RecordedContext",
      "type": "object"
    },
    "SuccessfulProbe": {
      "additionalProperties": false,
      "properties": {
        "target_id": {
          "$ref": "#/$defs/NetworkNodeId"
        },
        "offset_ms": {
          "maximum": 1805000,
          "minimum": 0,
          "title": "Offset Ms",
          "type": "integer"
        },
        "hidden": {
          "title": "Hidden",
          "type": "boolean"
        },
        "browser_delay_ms": {
          "maximum": 86400000,
          "minimum": 0,
          "title": "Browser Delay Ms",
          "type": "integer"
        },
        "status": {
          "const": "ok",
          "title": "Status",
          "type": "string"
        },
        "rtt_ms": {
          "maximum": 5000,
          "minimum": 0,
          "title": "Rtt Ms",
          "type": "number"
        }
      },
      "required": [
        "target_id",
        "offset_ms",
        "hidden",
        "browser_delay_ms",
        "status",
        "rtt_ms"
      ],
      "title": "SuccessfulProbe",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "started_at_ms": {
      "minimum": 0,
      "title": "Started At Ms",
      "type": "integer"
    },
    "duration_ms": {
      "maximum": 1800000,
      "minimum": 0,
      "title": "Duration Ms",
      "type": "integer"
    },
    "title": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "notes": {
      "default": "",
      "maxLength": 2000,
      "title": "Notes",
      "type": "string"
    },
    "targets": {
      "items": {
        "$ref": "#/$defs/NetworkTarget"
      },
      "maxItems": 16,
      "minItems": 1,
      "title": "Targets",
      "type": "array"
    },
    "probes": {
      "items": {
        "$ref": "#/$defs/NetworkProbe"
      },
      "maxItems": 15000,
      "title": "Probes",
      "type": "array"
    },
    "contexts": {
      "items": {
        "$ref": "#/$defs/RecordedContext"
      },
      "maxItems": 1000,
      "title": "Contexts",
      "type": "array"
    },
    "markers": {
      "items": {
        "$ref": "#/$defs/NetworkMarker"
      },
      "maxItems": 100,
      "title": "Markers",
      "type": "array"
    },
    "monitored_app": {
      "anyOf": [
        {
          "$ref": "#/$defs/NetworkMonitoredApp"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "bandwidth_tests": {
      "items": {
        "$ref": "#/$defs/NetworkRecordedBandwidthTest"
      },
      "maxItems": 5,
      "title": "Bandwidth Tests",
      "type": "array"
    }
  },
  "required": [
    "id",
    "started_at_ms",
    "duration_ms",
    "title",
    "targets",
    "probes",
    "contexts",
    "markers"
  ],
  "title": "NetworkReportInput",
  "type": "object"
}
